# === LLM Wiki (.env at project root) ===

# File-system wiki root (can point to an Obsidian vault)
WIKI_ROOT=./wiki_data/

# Single user ID (leave empty to auto-generate)
# SINGLE_USER_ID=

# Local storage root (for TUS upload temp files)
STORAGE_ROOT=./data/files/

# Ollama (for embedding and RAG)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LLM_MODEL=qwen2.5:14b

# Stage
STAGE=dev

# URLs
APP_URL=http://localhost:8000
API_URL=http://localhost:8000
MCP_URL=http://localhost:8080/mcp

# Mistral OCR (optional, requires MISTRAL_API_KEY)
# PDF_BACKEND=pdf_oxide
# MISTRAL_API_KEY=

# Observability (optional)
# LOGFIRE_TOKEN=
# SENTRY_DSN=

# === Agent 配置（详见 agent/.env.example）===
# Provider 和模型
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# AGENT_API_BASE=

# 行为
# AGENT_SCAN_INTERVAL=60
# AGENT_MAX_TOOL_ROUNDS=30
# AGENT_GIT_NAME=LLM Wiki Agent
# AGENT_GIT_EMAIL=agent@llmwiki.local

# 日志（默认 ./logs/ 相对项目根，可改为绝对路径）
# AGENT_LOG_DIR=./logs/
# AGENT_LOG_LEVEL=INFO
# AGENT_LOG_BACKUPS=7
# AGENT_LOG_ERROR_BACKUPS=4

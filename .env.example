# === LLM Wiki (.env at project root) ===

# File-system wiki root (can point to an Obsidian vault)
WIKI_ROOT=./wiki_data/

# Single user ID (leave empty to auto-generate)
# SINGLE_USER_ID=

# Local storage root (for TUS upload temp files)
STORAGE_ROOT=./data/files/

# Ollama (for embedding and RAG)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LLM_MODEL=qwen2.5:14b

# Stage
STAGE=dev

# URLs
APP_URL=http://localhost:8000
API_URL=http://localhost:8000
MCP_URL=http://localhost:8080/mcp

# Converter (optional, for office document processing)
# CONVERTER_URL=http://localhost:8081
# CONVERTER_SECRET=

# Mistral OCR (optional, requires MISTRAL_API_KEY)
# PDF_BACKEND=pdf_oxide
# MISTRAL_API_KEY=

# Observability (optional)
# LOGFIRE_TOKEN=
# SENTRY_DSN=

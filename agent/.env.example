# === LLM Wiki Agent 配置 ===
# 复制此文件为 .env 并根据需要修改。
# 共享变量（WIKI_ROOT、OLLAMA_URL 等）从 ../.env 读取，此处可覆盖。

# ── Provider ──────────────────────────────────────────────────
# 可选值: anthropic | openai_compat | ollama
AGENT_PROVIDER=ollama

# 模型名:
#   anthropic: claude-sonnet-4-5 | claude-opus-4-8 | claude-haiku-4-5
#   openai_compat: deepseek-chat | moonshot-v1-8k | qwen-plus | ...
#   ollama: qwen2.5:14b | llama3.2-vision:11b | ...
AGENT_MODEL=qwen2.5:14b

# API Key — 根据 provider 选择对应的环境变量:
#   anthropic → ANTHROPIC_API_KEY
#   openai_compat → OPENAI_API_KEY / DEEPSEEK_API_KEY / KIMI_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible 的 API 地址（仅 openai_compat 需要）
# DeepSeek: https://api.deepseek.com/v1
# Kimi: https://api.moonshot.cn/v1
# 千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_API_BASE=

# ── Ollama（仅 ollama provider 需要）──────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Wiki ──────────────────────────────────────────────────────
# Wiki 根目录（通常由 ../.env 设置，如需覆盖可取消注释）
# WIKI_ROOT=./wiki_data/

# ── Agent 行为 ────────────────────────────────────────────────
# 扫描间隔（秒），默认 60
# AGENT_SCAN_INTERVAL=60

# 运行日志路径（默认 agent/agent.log）
# AGENT_LOG_FILE=

# 最大工具调用轮数（防止死循环），默认 30
# AGENT_MAX_TOOL_ROUNDS=30

# ── Git ───────────────────────────────────────────────────────
# AGENT_GIT_NAME=LLM Wiki Agent
# AGENT_GIT_EMAIL=agent@llmwiki.local
